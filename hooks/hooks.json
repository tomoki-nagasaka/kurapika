{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/kurapika.py\" hook session-start",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
